/* 全局样式 — QuantTrader Design System */
page {
  background: #f5f6f8;
  color: #1a1a2e;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

/* ========== 盈亏色 — A股红涨绿跌 ========== */
.pnl-up { color: #e05555; }
.pnl-down { color: #22c55e; }
.pnl-zero { color: #9ca3af; }

/* ========== 市场标签 ========== */
.tag-a-share {
  background: #fef1f1;
  color: #e05555;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.tag-us-stock {
  background: #eef2ff;
  color: #4f6ef7;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

/* ========== 通用容器 ========== */
.container {
  padding: 24rpx;
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

/* ========== 通用卡片 ========== */
.card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
}

/* ========== 区块标题 ========== */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 20rpx;
}

/* ========== 状态指示点 ========== */
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d1d5db;
  flex-shrink: 0;
}

.dot.open { background: #4ade80; }
.dot.closed { background: #d1d5db; }

/* ========== 策略图标 ========== */
.st-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.st-icon-a { background: linear-gradient(135deg, #e05555, #f07070); }
.st-icon-u { background: linear-gradient(135deg, #4f6ef7, #7b93f9); }

/* ========== 指标网格 ========== */
.metrics-row {
  display: flex;
  gap: 0;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0,0,0,0.04);
}

.metric {
  flex: 1;
  text-align: center;
}

.metric-val {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.metric-label {
  display: block;
  font-size: 20rpx;
  color: #b0b0b0;
  margin-top: 4rpx;
}

/* ========== 盈亏背景色 ========== */
.bg-up { background: rgba(224,85,85,0.25); color: #ff8a8a; }
.bg-down { background: rgba(34,197,94,0.2); color: #6ee7b7; }
.bg-zero { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.5); }
.bg-up-light { background: #fef1f1; }
.bg-down-light { background: #f0fdf4; }
.bg-zero-light { background: #f3f4f6; }

/* ========== 深色文字配色 ========== */
.c-up { color: #ff8a8a; }
.c-down { color: #6ee7b7; }
.c-zero { color: rgba(255,255,255,0.4); }

/* ========== 按钮主色 ========== */
.btn-primary {
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #78350f;
  border-radius: 40rpx;
  padding: 18rpx 48rpx;
  text-align: center;
  font-weight: 700;
  font-size: 28rpx;
}

/* ========== 会员引导 ========== */
.member-banner {
  background: linear-gradient(135deg, #fefce8, #fef3c7);
  border-radius: 20rpx;
  padding: 36rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.member-banner .title {
  font-size: 32rpx;
  font-weight: 700;
  color: #92400e;
  margin-bottom: 12rpx;
}

.member-banner .desc {
  font-size: 24rpx;
  color: #b45309;
  margin-bottom: 24rpx;
}

/* ========== 空状态 ========== */
.empty-text {
  text-align: center;
  color: #9ca3af;
  padding: 80rpx 0;
  font-size: 28rpx;
}
