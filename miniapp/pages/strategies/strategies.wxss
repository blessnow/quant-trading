/* pages/strategies/strategies.wxss */

/* ========== 深色头部 ========== */
.hero {
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2b55 100%);
  padding: 48rpx 36rpx 36rpx;
  margin: -24rpx -24rpx 24rpx;
  color: #fff;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}

/* ========== 排行榜 ========== */
.rank-hint {
  font-size: 22rpx;
  color: #9ca3af;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.rank-item:last-child { border-bottom: none; }

.rank-medal {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: #9ca3af;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rank-top-1 { background: linear-gradient(135deg, #f59e0b, #fbbf24); color: #78350f; }
.rank-top-2 { background: linear-gradient(135deg, #9ca3af, #d1d5db); color: #fff; }
.rank-top-3 { background: linear-gradient(135deg, #b45309, #d97706); color: #fff; }

.rank-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: block;
}

.rank-detail {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  display: block;
}

.rank-pnl {
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* ========== 策略卡片 ========== */
.st-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.st-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.st-info {
  flex: 1;
  min-width: 0;
}

.st-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: block;
}

.st-desc {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  display: block;
}

.st-schedule {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 12rpx;
  padding-left: 76rpx;
}
