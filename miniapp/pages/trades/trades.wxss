/* pages/trades/trades.wxss — 文章观点 */

/* ========== 深色头部 ========== */
.hero {
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2b55 100%);
  padding: 48rpx 36rpx 36rpx;
  margin: -24rpx -24rpx 0;
  color: #fff;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.hero-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}

/* ========== 分类药丸 ========== */
.cat-pills {
  display: flex;
  gap: 12rpx;
  padding: 24rpx 0 8rpx;
}

.cat-pill {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: #fff;
  color: #9ca3af;
  border: 1rpx solid rgba(0,0,0,0.06);
}

.cat-pill-on {
  background: #1a1a2e;
  color: #fff;
  border-color: transparent;
}

/* ========== 文章卡片 ========== */
.article-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 20rpx;
}

.article-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.5;
}

.article-summary {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 12rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.article-cat-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #eef2ff;
  color: #4f6ef7;
  font-weight: 600;
}

.article-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #f3f4f6;
  color: #6b7280;
}

.article-meta-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.article-date {
  font-size: 20rpx;
  color: #9ca3af;
}

.article-dot {
  font-size: 20rpx;
  color: #d1d5db;
}

.article-views {
  font-size: 20rpx;
  color: #9ca3af;
}
