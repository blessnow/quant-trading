/* pages/index/index.wxss — 基金APP风格 */

/* ========== 页面底色 ========== */
.page {
  background: #f5f6f8;
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 深色资产头部 ========== */
.hero {
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2b55 100%);
  padding: 48rpx 36rpx 36rpx;
  color: #fff;
}

.hero-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  display: block;
  margin-bottom: 8rpx;
}

.hero-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.hero-value {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.hero-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.bg-up { background: rgba(224,85,85,0.25); color: #ff8a8a; }
.bg-down { background: rgba(34,197,94,0.2); color: #6ee7b7; }
.bg-zero { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.5); }

.hero-markets {
  display: flex;
  background: rgba(255,255,255,0.08);
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.hm-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.hm-divider {
  width: 1rpx;
  background: rgba(255,255,255,0.12);
}

.hm-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hm-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
}

.hm-dot.on { background: #4ade80; }

.hm-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

.hm-val {
  font-size: 28rpx;
  font-weight: 600;
}

.hm-pnl {
  font-size: 22rpx;
}

.c-up { color: #ff8a8a; }
.c-down { color: #6ee7b7; }
.c-zero { color: rgba(255,255,255,0.4); }

/* ========== 通用卡片 ========== */
.card {
  background: #fff;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx 28rpx 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
}

/* ========== 收益曲线 ========== */
.curve-pills {
  display: flex;
  background: #f3f4f6;
  border-radius: 8rpx;
  overflow: hidden;
}

.pill {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  color: #9ca3af;
}

.pill-on {
  background: #1a1a2e;
  color: #fff;
  border-radius: 8rpx;
}

.time-bar {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.tb {
  font-size: 22rpx;
  color: #9ca3af;
  padding: 6rpx 0;
  position: relative;
}

.tb-on {
  color: #e05555;
  font-weight: 600;
}

.tb-on::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background: #e05555;
  border-radius: 2rpx;
}

.curve-info {
  margin-bottom: 12rpx;
}

.ci-main {
  font-size: 28rpx;
  font-weight: 700;
  color: #e05555;
  margin-right: 12rpx;
}

.ci-sub {
  font-size: 22rpx;
  color: #b0b0b0;
}

.chart-canvas { width: 100%; height: 440rpx; }

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 12rpx;
}

.lg {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #b0b0b0;
}

.lg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }

.lg-dash {
  width: 22rpx;
  border-top: 2rpx dashed #999;
}

/* ========== 策略卡片 ========== */
.st-card {
  background: #f8f9fb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.st-card:last-child { margin-bottom: 0; }

.st-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.st-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.st-icon-a { background: linear-gradient(135deg, #e05555, #f07070); }
.st-icon-u { background: linear-gradient(135deg, #4f6ef7, #7b93f9); }

.st-info {
  flex: 1;
  min-width: 0;
}

.st-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: block;
}

.st-desc {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  display: block;
}

.st-pnl-box {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.bg-up-light { background: #fef1f1; }
.bg-down-light { background: #f0fdf4; }
.bg-zero-light { background: #f3f4f6; }

.st-arrow {
  flex-shrink: 0;
  padding-left: 8rpx;
}

.arrow-icon {
  font-size: 28rpx;
  color: #d0d0d0;
}

/* 策略指标 */
.st-metrics {
  display: flex;
  gap: 0;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0,0,0,0.04);
}

.sm {
  flex: 1;
  text-align: center;
}

.sm-val {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.sm-label {
  display: block;
  font-size: 20rpx;
  color: #b0b0b0;
  margin-top: 4rpx;
}

.st-lock {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0,0,0,0.04);
}

.st-lock-text {
  font-size: 22rpx;
  color: #c5c5c5;
}

/* ========== 会员引导 ========== */
.member-banner {
  background: linear-gradient(135deg, #fefce8, #fef3c7);
  border-radius: 20rpx;
  padding: 36rpx;
  text-align: center;
  margin: 24rpx;
}

.mb-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #92400e;
  margin-bottom: 8rpx;
}

.mb-desc {
  font-size: 24rpx;
  color: #b45309;
  margin-bottom: 24rpx;
}

.mb-btn {
  display: inline-block;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #78350f;
  font-size: 28rpx;
  font-weight: 700;
  padding: 18rpx 60rpx;
  border-radius: 40rpx;
}

.footer-space { height: 40rpx; }
