/* pages/my/my.wxss */

/* ========== 深色头部 ========== */
.hero {
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2b55 100%);
  padding: 48rpx 36rpx 56rpx;
  margin: -24rpx -24rpx 24rpx;
  color: #fff;
}

.hero-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #78350f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(245,158,11,0.2);
  color: #fbbf24;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.hero-badge-dim {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.5);
}

.badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #4ade80;
}

/* ========== 升级卡片 ========== */
.upgrade-card {
  background: linear-gradient(135deg, #fefce8, #fef3c7);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.upgrade-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #78350f;
  font-size: 18rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.upgrade-info {
  flex: 1;
  min-width: 0;
}

.upgrade-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #92400e;
  display: block;
}

.upgrade-desc {
  font-size: 22rpx;
  color: #b45309;
  margin-top: 4rpx;
  display: block;
}

.upgrade-arrow {
  color: #d1a945;
  font-size: 28rpx;
  flex-shrink: 0;
}

/* ========== 菜单项 ========== */
.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.menu-item:last-child { border-bottom: none; }

.menu-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon {
  font-size: 22rpx;
  font-weight: 800;
}

.menu-text {
  font-size: 28rpx;
  color: #1a1a2e;
  flex: 1;
}

.menu-text-wrap {
  flex: 1;
  min-width: 0;
}

.menu-text-wrap .menu-text {
  display: block;
}

.menu-desc {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 2rpx;
  display: block;
}

.menu-arrow {
  color: #d1d5db;
  font-size: 28rpx;
  flex-shrink: 0;
}
