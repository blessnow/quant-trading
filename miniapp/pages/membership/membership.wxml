<!--pages/membership/membership.wxml-->
<view class="page">
  <!-- 深色头部 -->
  <view class="hero">
    <view class="hero-icon">Q</view>
    <text class="hero-title">QuantTrader 会员</text>
    <text class="hero-desc">解锁完整量化交易数据</text>
  </view>

  <!-- 权益列表 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">会员权益</text>
    </view>
    <view class="benefit-item">
      <view class="benefit-icon-wrap" style="background:#fef1f1">
        <text class="benefit-icon" style="color:#e05555">1</text>
      </view>
      <view class="benefit-info">
        <text class="benefit-title">实时持仓详情</text>
        <text class="benefit-desc">查看每个策略的实时持仓和盈亏</text>
      </view>
    </view>
    <view class="benefit-item">
      <view class="benefit-icon-wrap" style="background:#f0fdf4">
        <text class="benefit-icon" style="color:#22c55e">2</text>
      </view>
      <view class="benefit-info">
        <text class="benefit-title">完整交易记录</text>
        <text class="benefit-desc">所有买卖明细、成交价格</text>
      </view>
    </view>
    <view class="benefit-item">
      <view class="benefit-icon-wrap" style="background:#eef2ff">
        <text class="benefit-icon" style="color:#4f6ef7">3</text>
      </view>
      <view class="benefit-info">
        <text class="benefit-title">策略绩效排行</text>
        <text class="benefit-desc">胜率、夏普、最大回撤等核心指标</text>
      </view>
    </view>
    <view class="benefit-item">
      <view class="benefit-icon-wrap" style="background:#fefce8">
        <text class="benefit-icon" style="color:#f59e0b">4</text>
      </view>
      <view class="benefit-info">
        <text class="benefit-title">收益曲线全周期</text>
        <text class="benefit-desc">1周至3年收益走势 + 基准对比</text>
      </view>
    </view>
    <view class="benefit-item">
      <view class="benefit-icon-wrap" style="background:#fdf2f8">
        <text class="benefit-icon" style="color:#ec4899">5</text>
      </view>
      <view class="benefit-info">
        <text class="benefit-title">策略启停控制</text>
        <text class="benefit-desc">自主管理策略运行状态</text>
      </view>
    </view>
  </view>

  <!-- 套餐选择 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">选择套餐</text>
    </view>
    <view class="plan-row">
      <view class="plan-card {{plan === 'monthly' ? 'plan-selected' : ''}}" bindtap="selectPlan" data-plan="monthly">
        <text class="plan-label">月度会员</text>
        <text class="plan-price">¥49<text class="plan-unit">/月</text></text>
      </view>
      <view class="plan-card {{plan === 'yearly' ? 'plan-selected' : ''}}" bindtap="selectPlan" data-plan="yearly">
        <view class="plan-badge">推荐</view>
        <text class="plan-label">年度会员</text>
        <text class="plan-price">¥399<text class="plan-unit">/年</text></text>
        <text class="plan-save">省¥189</text>
      </view>
    </view>

    <!-- 支付按钮 -->
    <view class="btn-primary pay-btn" bindtap="handlePay">
      {{paying ? '处理中...' : '立即开通'}}
    </view>
    <text class="pay-note">测试模式：点击即可激活，无需真实支付</text>
  </view>
</view>
