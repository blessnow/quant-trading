/* pages/membership/membership.wxss */

/* ========== 深色头部 ========== */
.hero {
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2b55 100%);
  padding: 56rpx 36rpx 48rpx;
  margin: -24rpx -24rpx 0;
  color: #fff;
  text-align: center;
}

.hero-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #78350f;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}

.hero-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  display: block;
}

/* ========== 权益列表 ========== */
.benefit-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.benefit-item:last-child { border-bottom: none; }

.benefit-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.benefit-icon {
  font-size: 20rpx;
  font-weight: 800;
}

.benefit-info {
  flex: 1;
  min-width: 0;
}

.benefit-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: block;
}

.benefit-desc {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 2rpx;
  display: block;
}

/* ========== 套餐选择 ========== */
.plan-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.plan-card {
  flex: 1;
  border: 3rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  position: relative;
  background: #fff;
  transition: all 0.2s;
}

.plan-selected {
  border-color: #f59e0b;
  background: #fffbeb;
}

.plan-badge {
  position: absolute;
  top: -14rpx;
  right: 16rpx;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #78350f;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 700;
}

.plan-label {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.plan-price {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.plan-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #9ca3af;
}

.plan-save {
  display: block;
  font-size: 22rpx;
  color: #f59e0b;
  margin-top: 8rpx;
  font-weight: 600;
}

/* ========== 支付 ========== */
.pay-btn {
  margin-top: 8rpx;
  font-size: 32rpx;
}

.pay-note {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 16rpx;
}
