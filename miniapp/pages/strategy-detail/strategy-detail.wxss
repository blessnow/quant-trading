/* pages/strategy-detail/strategy-detail.wxss */

/* ========== 深色头部 ========== */
.hero {
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2b55 100%);
  padding: 48rpx 36rpx 36rpx;
  margin: -24rpx -24rpx 0;
  color: #fff;
}

.hero-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.hero-tags {
  display: flex;
  gap: 12rpx;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.6);
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.hero-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  display: block;
  line-height: 1.6;
}

/* ========== 绩效网格 ========== */
.metrics-grid {
  display: flex;
  gap: 10rpx;
  align-items: stretch;
}

.metric-box {
  flex: 1;
  padding: 14rpx 2rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.metric-box .metric-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #1a1a2e;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.metric-box .metric-label {
  font-size: 18rpx;
  color: #b0b0b0;
  height: 18rpx;
  line-height: 18rpx;
  margin-top: 6rpx;
  text-align: center;
  white-space: nowrap;
}

/* ========== 卡片小标题 ========== */
.card-bench {
  font-size: 22rpx;
  color: #9ca3af;
}

.card-count {
  font-size: 22rpx;
  color: #9ca3af;
}

/* ========== 时间范围 ========== */
.time-bar {
  display: flex;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.tb {
  font-size: 22rpx;
  color: #9ca3af;
  padding: 6rpx 0;
  position: relative;
}

.tb-on {
  color: #e05555;
  font-weight: 600;
}

.tb-on::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background: #e05555;
  border-radius: 2rpx;
}

/* ========== 图表 ========== */
.chart-canvas { width: 100%; height: 440rpx; }

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 12rpx;
}

.lg {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #b0b0b0;
}

.lg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }

.lg-dash {
  width: 22rpx;
  border-top: 2rpx dashed #999;
}

/* ========== 持仓 ========== */
.pos-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.pos-row:last-child { border-bottom: none; }

.pos-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pos-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.pos-name-wrap {
  display: flex;
  flex-direction: column;
}

.pos-symbol {
  font-family: 'SF Mono', monospace;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.pos-name {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 2rpx;
}

.pos-right {
  text-align: right;
}

.pos-shares {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
}

.pos-pnl {
  font-size: 24rpx;
  font-weight: 600;
  display: block;
  margin-top: 2rpx;
}

/* ========== 交易列表 ========== */
.trade-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.trade-row:last-child { border-bottom: none; }

.trade-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.trade-side {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.trade-buy {
  background: #fef1f1;
  color: #e05555;
}

.trade-sell {
  background: #f0fdf4;
  color: #22c55e;
}

.trade-info {
  display: flex;
  flex-direction: column;
}

.trade-symbol {
  font-family: 'SF Mono', monospace;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.trade-time {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 2rpx;
}

.trade-right {
  text-align: right;
}

.trade-price {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
}

.trade-pnl {
  font-size: 24rpx;
  font-weight: 600;
  display: block;
  margin-top: 2rpx;
}
