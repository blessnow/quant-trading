# 复制为 .env 后按需填写

# 微信支付 APIv3（WX_MCH_ID 留空则 Native/JSAPI 为 mock）
WX_MCH_ID=
WX_MCH_SERIAL_NO=
WX_API_V3_KEY=
WX_MCH_PRIVATE_KEY_PATH=
WX_PAY_NOTIFY_URL=https://your-domain.com/api/pay/notify

WX_APPID=
WX_SECRET=

# 短信：mock=不调真实通道 / aliyun=阿里云
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=QuantTrader
SMS_TEMPLATE_CODE=

JWT_SECRET=

# Railway：监听私网（默认在检测到 RAILWAY_* 时用 ::，一般无需改）
# API_HOST=::

# 为 true 时：经公网域名访问仅放行支付/扫码回调等路径；API 应由前端经私网调用。
# Next rewrite 已会改 Host 为后端内网；本中间件亦放行 TCP 对端为私网 IP（同项目前端容器）。
# 须在 Railway 后端关闭 Public Networking，或作应用层加固。
# 额外公网路径（逗号分隔）：BACKEND_PUBLIC_PATHS=/api/foo/bar
# BACKEND_PRIVATE_ONLY=true
